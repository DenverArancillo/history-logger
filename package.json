{
    "name": "history-logger",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "tsbuild": "tsc",
        "tswatch": "tsc -w",
        "createdb": "npm run tsbuild && node --env-file=.env dist/database/script/create-db",
        "start": "tsc && node --env-file=.env dist/server",
        "dev": "node --watch --env-file=.env dist/server",
        "test:postman:tag": "newman run tests/postman/tags.postman_collection.json -e tests/postman/env/historylog.postman_environment.json",
        "test:postman:history_item": "newman run tests/postman/history_item.postman_collection.json -e tests/postman/env/historylog.postman_environment.json"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "colors": "^1.4.0",
        "express": "^4.21.2",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.0.0",
        "@types/express": "^5.0.3",
        "@types/node": "^24.1.0",
        "newman": "^6.2.1",
        "typescript": "^5.8.3"
    }
}
